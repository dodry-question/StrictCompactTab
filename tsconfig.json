{
  // Этап P0: типовая проверка существующего JS-кода БЕЗ переписывания в .ts и
  // без сборки. tsc читает .js (allowJs) и проверяет их (checkJs) ровно так,
  // как это делает редактор.
  //
  // Строгость включается ПОШАГОВО и БЕЗ перевода файлов в .ts (решение P2 от
  // 04.10.2026: рантайм остаётся .js, сборки нет). Состояние на 05.10.2026:
  // P2.1/P2.2 сделаны (AppState дополнен, типы переехали в модульный
  // types/app-state.d.ts, any-каст STATE снят); следующий шаг — P2.3
  // noImplicitAny. Его цена измерена пробным конфигом: 588 ошибок в 32 файлах
  // (TS7006 ×348 — параметры без типа, TS7005 ×157 — переменные), поэтому шаг
  // имеет смысл только при активной разработке: для рантайма он ничего не
  // меняет (журнал — §14.9/§14.10 СВОДКА.md).
  //
  // ОБЛАСТЬ ПРОВЕРКИ: весь проект (P1 — DOM-типизация app/* и UI-сервисов
  // выполнена: getElementById/querySelector приведены к HTMLInputElement/
  // HTMLSelectElement/HTMLButtonElement/HTMLFormElement/HTMLImageElement,
  // e.target и результаты querySelectorAll — типизированы JSDoc-кастами).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    // Ловит реально неиспользуемый код по всей программе (см. комментарий в
    // eslint.config.js про отключённый no-unused-vars у ESLint).
    "noUnusedLocals": true
  },
  "include": [
    "favicon-loader.js",
    "src/**/*.js",
    "services/**/*.js",
    "app/**/*.js",
    "state/**/*.js",
    "storage/**/*.js",
    "i18n/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "tests", "tools"]
}
