root = true

# Файлы репозитория хранятся с CRLF — фиксируем это, чтобы редакторы не
# переписывали окончания строк и не создавали «пустых» диффов на весь проект.
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
